<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>CADdy</name>
  <description>AI assistant inside FreeCAD. You draw, the AI continues, you keep
  going - all on one live document. It measures its work (overlaps, open shells,
  inside-out solids, printability) instead of guessing.</description>
  <version>0.1.0</version>
  <date>2026-08-18</date>
  <maintainer email="77415793+furkanbulus123@users.noreply.github.com">Furkan Bulus</maintainer>
  <license>MIT</license>
  <icon>resources/icons/caddy.svg</icon>
  <freecadmin>1.1</freecadmin>
  <content>
    <workbench>
      <classname>CADdyWorkbench</classname>
      <name>CADdy</name>
      <description>AI chat panel</description>
      <!-- Flat layout: InitGui.py is in the root. With a package.xml, FreeCAD
           runs InitGui.py from each subdirectory, not from the root, so "./"
           is required. -->
      <subdirectory>./</subdirectory>
      <icon>resources/icons/caddy.svg</icon>
    </workbench>
  </content>
</package>
